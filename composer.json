{
    "name": "italix/forms",
    "description": "Form metadata and HTML rendering: FormMeta/FieldMeta descriptors, widgets, and adapters that build a form from a table schema",
    "type": "library",
    "license": "MPL-2.0",
    "version": "2.2.1",
    "keywords": [
        "forms",
        "form-builder",
        "html",
        "widgets",
        "schema",
        "metadata"
    ],
    "homepage": "https://github.com/italix-net/forms",
    "authors": [
        {
            "name": "Italix",
            "email": "info@italix.net"
        }
    ],
    "require": {
        "php": ">=7.4",
        "italix/contracts": "^2.0"
    },
    "suggest": {
        "italix/rules": "Executes the rules a FieldMeta carries \u2014 Forms only transports them",
        "italix/orm": "Build a form directly from a Table schema"
    },
    "require-dev": {
        "italix/rules": "^4.0",
        "italix/testing": "^2.0",
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "Italix\\Forms\\": ""
        },
        "files": [
            "functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Italix\\Forms\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": [
            "php tests/FormMetaTest.php",
            "php tests/FormHtmlTest.php",
            "php tests/DerivationTest.php"
        ],
        "test:phpunit": "phpunit"
    }
}
