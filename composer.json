{
    "name": "italix/forms",
    "description": "Form metadata, validation, and layout library - works with any ORM or standalone",
    "type": "library",
    "license": "LGPL-3.0-or-later",
    "keywords": [
        "form",
        "forms",
        "validation",
        "metadata",
        "schema",
        "orm",
        "php"
    ],
    "authors": [
        {
            "name": "Italix",
            "homepage": "https://github.com/italix-net"
        }
    ],
    "support": {
        "issues": "https://github.com/italix-net/forms/issues",
        "source": "https://github.com/italix-net/forms"
    },
    "require": {
        "php": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "Italix\\Forms\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Italix\\Forms\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
